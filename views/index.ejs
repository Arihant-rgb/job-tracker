<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Tracker</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>My Job Application</h1>

    <ul>
        <% for(let job of jobs){ %>
            <li>
                <%=job.company %> - <%=job.role %> (<%=job.status %>)
            </li>
        <% } %>
    </ul>
    
</body>
</html>